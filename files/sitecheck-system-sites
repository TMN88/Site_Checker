#!/bin/sh
# Site_Checker implementation of the availability check shown in Zapret Manager's System tab.
# Upstream: ZapretManager_LuCI.sh (_test_prepare_urls and _si_sites), revision 721c5c5367cc277007e7f60bb2f13b475e68d295.
# Output fields: index|site_name|url|reachable|elapsed_ms|http_code
set -u

TMP="/tmp/site-checker-zm.$$"
LIST="$TMP/list"
RESULTS="$TMP/results"
JSON="$TMP/suite.v2.json"
mkdir -p "$TMP" "$RESULTS" || exit 1
trap 'rm -rf "$TMP"' EXIT
trap 'exit 1' HUP INT TERM
: > "$LIST"

# Static URLs used by the upstream System-tab checker.
cat > "$LIST" <<'SITECHECK_URLS'
# The same default sites as Site_Checker's first table, plus requested sites.
youtube.com|https://www.youtube.com/
WhatsApp|https://web.whatsapp.com/
Telegram|https://web.telegram.org/
TikTok|https://www.tiktok.com/
ChatGPT|https://chatgpt.com/
facebook.com|https://facebook.com
ntc.party|https://ntc.party/
openwrt.org|https://openwrt.org
downloads.openwrt.org|https://downloads.openwrt.org
play.google.com|https://play.google.com
githubusercontent.com|https://raw.githubusercontent.com/StressOzz/Zapret-Manager/refs/heads/main/Zapret-Manager.sh
rutracker.org|https://rutracker.org
gosuslugi.ru|https://www.gosuslugi.ru
nalog.ru|https://nalog.ru
gosuslugi.ru|https://www.gosuslugi.ru
esia.gosuslugi.ru|https://esia.gosuslugi.ru
nalog.ru|https://nalog.ru
lkfl2.nalog.ru|https://lkfl2.nalog.ru
rutube.ru|https://rutube.ru
ntc.party|https://ntc.party/
instagram.com|https://instagram.com
facebook.com|https://facebook.com
rutracker.org|https://rutracker.org
nnmclub.to|https://nnmclub.to
rutor.info|https://rutor.info
openwrt.org|https://openwrt.org
discord.com|https://discord.com
x.com|https://x.com
forum.ru-board.com|https://forum.ru-board.com
play.google.com|https://play.google.com
downloads.openwrt.org|https://downloads.openwrt.org
githubusercontent.com|https://raw.githubusercontent.com/StressOzz/Zapret-Manager/refs/heads/main/Zapret-Manager.sh
SITECHECK_URLS

# The upstream System checker adds hosts from this live JSON source.
DOMAINS_JSON="https://raw.githubusercontent.com/hyperion-cs/dpi-checkers/refs/heads/main/ru/tcp-16-20/suite.v2.json"
if curl -fsSL --connect-timeout 8 --max-time 15 "$DOMAINS_JSON" -o "$JSON" 2>/dev/null; then
    sed -n 's/.*"id":[[:space:]]*"\([^"]*\)".*"host":[[:space:]]*"\([^"]*\)".*/\1|\2/p' "$JSON" |
    while IFS='|' read -r _id host; do
        case "$host" in
            ''|*[!A-Za-z0-9.-]*) continue ;;
        esac
        # Show a hostname rather than the upstream dataset's provider ID.
        printf '%s|https://%s/\n' "$host" "$host" >> "$LIST"
    done
fi

run_one() {
    idx="$1"
    name="$2"
    url="$3"
    result="$(/usr/libexec/sitecheck-check-zapret "$url" 2>/dev/null)"
    ok="$(printf '%s' "$result" | cut -d '|' -f 1)"
    ms="$(printf '%s' "$result" | cut -d '|' -f 2)"
    code="$(printf '%s' "$result" | cut -d '|' -f 3)"
    case "$ok" in 0|1) ;; *) ok=0 ;; esac
    case "$ms" in ''|*[!0-9]*) ms=0 ;; esac
    case "$code" in ''|*[!0-9]*) code=0 ;; esac
    printf '%s|%s|%s|%s|%s|%s\n' "$idx" "$name" "$url" "$ok" "$ms" "$code" > "$RESULTS/$idx"
}

total=0
active=0
while IFS='|' read -r name url; do
    [ -n "$name" ] && [ -n "$url" ] || continue
    total=$((total + 1))
    run_one "$total" "$name" "$url" &
    active=$((active + 1))
    if [ "$active" -ge 10 ]; then
        wait
        active=0
    fi
done < "$LIST"
wait

idx=1
while [ "$idx" -le "$total" ]; do
    [ ! -f "$RESULTS/$idx" ] || cat "$RESULTS/$idx"
    idx=$((idx + 1))
done
